# Скопируйте этот файл в .env и задайте значения
# Генерация ключа: python -c "import secrets; print(secrets.token_hex(32))"
SKUD_SECRET_KEY=замените_на_случайную_строку_32_байта

# Ключ шифрования NFC-токенов (Fernet, 32 байта base64url)
# Генерация: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NFC_TOKEN_KEY=generate_nfc_key_placeholder

# NFC настройки (раскомментируйте нужное)
# Интерфейс: spi (рекомендуется), i2c, uart
NFC_INTERFACE=spi
# GPIO пин RST (BCM нумерация, Pin 11 = GPIO 17)
NFC_RST_PIN=17
# GPIO пин IRQ (BCM нумерация, Pin 18 = GPIO 24) — только для I2C
NFC_IRQ_PIN=24
# SPI CE: 0 = GPIO8/Pin24, 1 = GPIO7/Pin26
NFC_SPI_CE=0
# UART порт (только для UART режима)
NFC_UART_PORT=/dev/serial0
